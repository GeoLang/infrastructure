# GeoLang Infrastructure - Example Configuration
#
# Copy this file to terraform.tfvars and customize:
#   cp terraform.tfvars.example terraform.tfvars
#
# Then deploy:
#   terraform init
#   terraform apply

# ─── General ──────────────────────────────────────────────────────────────────

aws_region   = "us-east-1"
project_name = "geolang"
environment  = "prod"      # dev | staging | prod

# ─── Domain (optional) ───────────────────────────────────────────────────────
# Uncomment to enable Route53 + ACM certificate for your domain.
# After apply, set the output name_servers at your domain registrar.

# enable_dns  = true
# domain_name = "geolang.com"

# ─── Database ────────────────────────────────────────────────────────────────
# RDS manages its master password in Secrets Manager. Runtime database URLs and
# application credentials must be populated outside Terraform. See README.md.

# db_instance_class    = "db.t4g.micro"   # ~$12/month
# db_allocated_storage = 20               # GB, auto-scales to 2x
# db_multi_az          = false            # true for production HA (~2x cost)

# ─── Service Toggles ────────────────────────────────────────────────────────
# Enable/disable individual services. See profiles/ for pre-built configs.

# enable_ptolemy   = true    # Geodatabase API (needs RDS)
# enable_tiletopia = true    # 3D Tiles / terrain
# enable_geokode   = false   # Geocoding
# enable_itinera   = false   # Routing
# enable_interiora = false   # Indoor maps + indoor routing
# enable_geoplumb  = false   # Windowed raster tiles over STAC
# enable_fenestra  = false   # OGC service gateway
# enable_agora     = false   # Live collaboration and an isolated RDS instance
# enable_sibyl     = false   # Agent loop
# enable_geodukt   = false   # Workflow runner
# enable_geolang_executor = false # Isolated tool executor
# enable_jupyter   = false   # Notebook kernels
# enable_geolang   = true    # AI agent
# enable_viewtopia = true    # Web frontend
# enable_platform_proxy = true # Public path-routing edge

# Keep services stopped until images, data, and every required secret value are
# ready.
# runtime_secrets_ready = false

# ─── Fargate Sizing ──────────────────────────────────────────────────────────
# Default sizing for all services. Override per-service with service_overrides.
#
# CPU/Memory valid combinations:
#   256  CPU → 512, 1024, 2048 MB
#   512  CPU → 1024–4096 MB
#   1024 CPU → 2048–8192 MB
#   2048 CPU → 4096–16384 MB
#   4096 CPU → 8192–30720 MB

# service_defaults = {
#   cpu           = 256
#   memory        = 512
#   desired_count = 1
# }

# service_overrides = {
#   geolang-api = {
#     cpu    = 1024
#     memory = 2048
#   }
# }

# ─── Container Images ───────────────────────────────────────────────────────
# Override container images (useful for CI/CD or external registries).
# If not set, uses ECR repositories created by Terraform.

# container_images = {
#   ptolemy   = "ghcr.io/geolang/ptolemy:latest"
#   tiletopia = "ghcr.io/geolang/tiletopia:latest"
# }

# Jupyter is not built from this repo and has no ECR repository, so it is pinned
# on its own. Pin a dated tag rather than latest.
# jupyter_image = "quay.io/jupyter/scipy-notebook:2025-12-31"

# ─── Runtime Secrets ─────────────────────────────────────────────────────────
# With enable_secrets = true Terraform creates an empty Secrets Manager entry per
# enabled service and you write the values outside Terraform. To use secrets you
# already manage, name them here instead and they win over the created ones.
#
# Names: platform_jwt, ptolemy_database_url, agora_database_url,
# geolang_executor, llm_api_key, jupyter_token.

# runtime_secret_arns = {
#   platform_jwt = "arn:aws:secretsmanager:us-east-1:123456789012:secret:platform-jwt-AbCdEf"
# }

# ─── CDN ──────────────────────────────────────────────────────────────────────

# enable_cdn = true   # CloudFront for tile caching at edge

# ─── Monitoring ──────────────────────────────────────────────────────────────

# log_retention_days        = 30
# enable_container_insights = true
